# .env.local 示例文件
# 复制为 .env.local 并填入真实密钥，.env.local 不会被提交到 git
# 加载优先级高于 .env，用于覆盖开发环境的真实配置

# OpenAI API Key（使用真实嵌入模型时必填）
OPENAI_API_KEY=sk-...

# DeepSeek API Key（用于 LLM 事实提取，可选）
DEEPSEEK_API_KEY=sk-...

# Google OAuth（连接器用，可选）
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...

# Notion OAuth（连接器用，可选）
# NOTION_CLIENT_ID=...
# NOTION_CLIENT_SECRET=...

# GitHub OAuth / App（连接器用，可选）
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# GITHUB_APP_ID=...
# GITHUB_APP_PRIVATE_KEY=...
