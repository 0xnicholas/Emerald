{
  "name": "@emerald/sdk",
  "version": "0.5.0",
  "description": "TypeScript SDK for Emerald — AI Agent memory and context infrastructure",
  "license": "MIT",
  "author": "Emerald Contributors",
  "keywords": ["emerald", "memory", "knowledge-graph", "ai-agent", "rag", "context"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-cjs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.5",
    "vitest": "^2.0",
    "@types/node": "^20.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emerald-ai/emerald",
    "directory": "sdk/typescript"
  }
}
